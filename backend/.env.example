# ===================================================
# GBEST STUDIO - Environment Configuration
# ===================================================

# Application
APP_NAME="GBEST STUDIO"
APP_ENV=development

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# IMPORTANT: Never commit actual client secret to version control!
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/auth/google/callback"

# Frontend Application URL (Where user is redirected after OAuth login)
FRONTEND_URL="http://localhost:5173"

# JWT Session Secret
JWT_SECRET_KEY="gbest-studio-jwt-secret-replace-with-secure-random-string"

# Optional AI APIs
OPENAI_API_KEY=""
WHISPER_MODEL="base"
